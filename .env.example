# 複製成 .env 後填入真正的值：cp .env.example .env
# .env 已列在 .gitignore，不會被 commit

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
# 主機對外的 port；本機若已有 Postgres 佔用 5432，就用 5433 避免衝突
POSTGRES_HOST_PORT=5433

# 同一個 Postgres 裡的兩個 database
# Airflow 自己的 metadata（DAG 執行紀錄等）
AIRFLOW_DB=airflow
# 股票資料（raw / staging / marts schema）
WAREHOUSE_DB=warehouse

# ---------- Airflow ----------
# Linux 上請設成 `id -u` 的結果，避免 logs/ 權限問題；macOS / Windows 維持 50000
AIRFLOW_UID=50000

# Airflow UI 的管理員帳號（第一次啟動時由 airflow-init 建立）
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme

# 用來加密 Airflow 裡存的連線密碼。產生方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Webserver session 用的密鑰，隨便一串長亂數即可。產生方式：
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=
