dbt/target/
dbt/dbt_packages/
dbt/logs/

# 本機資料庫資料（如果改用 bind mount）
pgdata/

# 編輯器與作業系統
.vscode/
.idea/
.DS_Store
Thumbs.db

# dbt 自動產生的匿名使用者 ID
dbt/.user.yml
